# Copy to .env, fill in what you have, then: chmod 600 .env
# ./scripts/run.sh reads this file; ./scripts/run.sh --demo ignores it.
# Variables already set in your shell take precedence. Never commit a real .env.

# --- NVIDIA Nemotron on Nebius Token Factory (enables Live mode for both apps) --
# Create a key at https://tokenfactory.nebius.com/
NEBIUS_API_KEY=

# --- Optional: make the other two Ask the Three seats live too ------------------
# Without these, the GPT and Claude seats are clearly labelled demo fixtures.
# OPENAI_API_KEY=
# ASK_THREE_OPENAI_MODEL=
# ANTHROPIC_API_KEY=
# ASK_THREE_ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Optional: speak your story instead of typing (Gemini Live transcription) ---
# Browser microphones need localhost or HTTPS.
# GEMINI_API_KEY=

# More app settings: apps/ask-the-three/.env.example, apps/otaku-gallery/.env.example
