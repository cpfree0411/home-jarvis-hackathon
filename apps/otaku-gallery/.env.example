# Optional. Leave empty for attributed source excerpts without AI.
NEBIUS_API_KEY=

OTAKU_HOST=127.0.0.1
OTAKU_PORT=8805
OTAKU_RESEARCH=1
# auto: live Wikipedia/AniList, bundled Wikipedia fallback; live: no snapshots;
# fixture: bundled snapshots only (AI still makes a paid call when a key is set).
OTAKU_EVIDENCE_MODE=auto
OTAKU_RATE_MAX_RUNS=10
OTAKU_CACHE_TTL=600
OTAKU_LOG_LEVEL=WARNING
# Optional licensed local artwork manifest (never committed):
# OTAKU_LOCAL_MANIFEST=media/gallery.json
# Optional explicit embedding/reverse proxy origins:
# OTAKU_FRAME_ANCESTORS='self' https://portal.example.org
# OTAKU_ALLOWED_ORIGINS=https://portal.example.org
