# Copy to .env, fill in what you have, then: chmod 600 .env
# Run with: ask-three-en serve --env-file .env
# Every value below is a placeholder. Never commit a real .env.

# --- Required for live NVIDIA Nemotron (organizer + first judge seat) -----------
# Create a key at https://tokenfactory.nebius.com/ (Nebius Token Factory).
NEBIUS_API_KEY=
# ASK_THREE_NEMOTRON_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# ASK_THREE_ORGANIZER_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# --- Optional: bring your own GPT and Claude judges ----------------------------
# Leave unset and the seat runs as a clearly labelled demo fixture (not live AI).
# OpenAI API:
# OPENAI_API_KEY=
# ASK_THREE_OPENAI_MODEL=
# Anthropic API:
# ANTHROPIC_API_KEY=
# ASK_THREE_ANTHROPIC_MODEL=claude-sonnet-5-5
# ...or an already logged-in local CLI (opt-in; runs with tools disabled):
# ASK_THREE_SEAT_GPT=codex-cli
# ASK_THREE_CODEX_MODEL=
# ASK_THREE_SEAT_CLAUDE=claude-cli
# ASK_THREE_CLAUDE_MODEL=claude-sonnet-5-5
# Force a seat to demo mode: ASK_THREE_SEAT_GPT=fixture

# --- Optional: speak instead of typing ------------------------------------------
# Live speech-to-text through Gemini Live transcription (server-side key).
# GEMINI_API_KEY=
# ASK_THREE_STT_LANGUAGE=en-US        # or "auto"

# --- Network (secure defaults: loopback only) -----------------------------------
# ASK_THREE_HOST=127.0.0.1
# ASK_THREE_PORT=8794
# ASK_THREE_ALLOWED_CLIENTS=127.0.0.1/32,::1/128
# ASK_THREE_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# ASK_THREE_ALLOWED_ORIGINS=http://127.0.0.1:8794,http://localhost:8794

# --- Cost guards ----------------------------------------------------------------
# ASK_THREE_MAX_INFLIGHT=2
# ASK_THREE_DAILY_LIVE_LIMIT=60

# --- State (defaults to $XDG_STATE_HOME/ask-three-en or ~/.local/state/ask-three-en)
# ASK_THREE_STATE=
